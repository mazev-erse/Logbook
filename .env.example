# Supabase Project Credentials
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Administrator Access
# Comma-separated list of emails authorized to access the Admin Dashboard
VITE_ADMIN_EMAIL=admin@example.com

# Optional: USDA FoodData Central API Key
# Sign up at https://fdc.nal.usda.gov/api-key-signup.html (Defaults to DEMO_KEY if unset)
# VITE_USDA_API_KEY=DEMO_KEY

